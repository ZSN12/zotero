# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# 运行产物（out 目录、临时输出）
out/
*.glb
*.obj

# 网页 demo 预生成产物（tower.glb / model.json / deliver 输出），
# 但 demo 的 HTML 查看器是源码，需纳入版本库。
web/demo/**/*.glb
web/demo/**/*.json
web/demo/**/latest_deliver/

# 35A1-JC1 单塔运行产物目录（canonical/skeleton/detail_atlas glb + index.html）
web/demo/35A1-JC1-hybrid/

# 敏感 / 大体积安装包
*.dmg
tools/oda-file-converter/ODAFileConverter.app/
tools/oda-file-converter/tmp-input/

# 系统
.DS_Store
.workbuddy/

# 本地 MLLM 密钥（勿提交）
.env

# 备份文件
*.bak
build/

# 联动追溯页：整目录白名单（SVG/overlay/演示 GLB 都是页面必需静态资产）；
# 运行产物仍由前面的 latest_deliver/ 与 *.glb 规则拦截。
!web/demo/**/trace/
web/demo/**/trace/*.glb.tmp
!web/demo/**/trace/*.glb
!web/demo/**/trace/*.json
# jc1.html 演示塔（GT 参考模型，690KB）：trace.html 双塔主视图不受影响，
# 此白名单只保证 demo 查看器在线上不黑屏。
!web/demo/35A1-JC1/gt_reference.glb

# Sheet intent classification (Phase 2)：per-sheet 意图缓存不进库
out/sheet_intent/
